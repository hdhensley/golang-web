package views

import (
    layout "golang-web/app/views/layouts"
)

templ SecondPage() {
    @layout.MainLayout("Test title", secondPageContent())
}

templ secondPageContent() {
    <div class="flex flex-col items-center justify-center h-full">
        <h1 hx-get="/hello">Second Page</h1>
    </div>
}