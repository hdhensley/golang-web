package views

import (
    layout "golang-web/app/views/layouts"
)

templ Home() {
    @layout.MainLayout("Home Title", homePageContent())
}

templ homePageContent() {
    <p class="text-sm font-thin">This is a paragraph</p>
    <p class="text-sm font-thin">This is another paragraph</p>
    <button class="btn btn-primary text-primary-content" hx-get="/hello" hx-target="#hello">Say Hello</button>
    <div id="hello"></div>
}